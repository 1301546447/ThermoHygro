<Window x:Class="ThermoHygro.App.SetupWizard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="首次使用向导" Height="620" Width="760"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        FontFamily="Microsoft YaHei UI" FontSize="13" Background="#F5F6F8">
  <DockPanel>
    <Border DockPanel.Dock="Top" Background="#1E5AA0" Padding="16,12">
      <StackPanel>
        <TextBlock Text="首次使用向导" Foreground="White" FontSize="17" FontWeight="SemiBold"/>
        <TextBlock x:Name="StepIndicator" Foreground="#CFE0F5" FontSize="12" Margin="0,4,0,0"/>
      </StackPanel>
    </Border>

    <Border DockPanel.Dock="Bottom" Background="White" Padding="14,10" BorderBrush="#DDE1E6" BorderThickness="0,1,0,0">
      <DockPanel>
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
          <Button x:Name="BtnBack" Content="上一步" Click="Back_Click" Padding="16,7" Margin="0,0,8,0"/>
          <Button x:Name="BtnNext" Content="下一步" Click="Next_Click" Padding="16,7" Margin="0,0,8,0" Background="#E8F5E9"/>
          <Button x:Name="BtnCancel" Content="取消" Click="Cancel_Click" Padding="16,7"/>
        </StackPanel>
        <TextBlock x:Name="FootHint" VerticalAlignment="Center" Foreground="#6B7280" FontSize="12"/>
      </DockPanel>
    </Border>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <Grid Margin="18">
        <StackPanel x:Name="Page1">
          <TextBlock Text="第 1 步：选择型号" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
          <ListBox x:Name="ModelList" Height="120" SelectionChanged="Model_Changed">
            <ListBoxItem Content="ECM-30（Modbus RTU，温度寄存器 0x0100 / 湿度 0x0105）" Tag="ecm30"/>
          </ListBox>
          <TextBlock Margin="0,12,0,0" TextWrapping="Wrap">
            本版本只提供 ECM-30 一个真实型号。说明：都叫 Modbus 并不意味着寄存器一致，
            其它型号需要单独适配后才能使用；本软件不做自动识别物理设备的宣称。
          </TextBlock>
          <TextBlock x:Name="ModelVerifyText" Margin="0,10,0,0" TextWrapping="Wrap" Foreground="#B26A00"/>
        </StackPanel>

        <StackPanel x:Name="Page2" Visibility="Collapsed">
          <TextBlock Text="第 2 步：设置串口" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
          <TextBlock Text="端口名称（可从列表选择，也可手动输入，例如 COM12）" Foreground="#6B7280"/>
          <DockPanel Margin="0,4,0,10">
            <Button DockPanel.Dock="Right" Content="刷新设备列表" Click="RefreshPorts_Click" Padding="14,7" Margin="8,0,0,0"/>
            <ComboBox x:Name="PortCombo" IsEditable="True" Height="32"/>
          </DockPanel>
          <TextBlock x:Name="PortHint" Foreground="#6B7280" TextWrapping="Wrap" Margin="0,0,0,10"/>
          <UniformGrid Columns="4">
            <StackPanel Margin="0,0,10,0">
              <TextBlock Text="波特率" Foreground="#6B7280"/>
              <ComboBox x:Name="BaudCombo" SelectedIndex="3" Height="32">
                <ComboBoxItem Content="1200"/><ComboBoxItem Content="2400"/>
                <ComboBoxItem Content="4800"/><ComboBoxItem Content="9600"/>
                <ComboBoxItem Content="19200"/><ComboBoxItem Content="38400"/>
              </ComboBox>
            </StackPanel>
            <StackPanel Margin="0,0,10,0">
              <TextBlock Text="数据位" Foreground="#6B7280"/>
              <ComboBox x:Name="DataBitsCombo" SelectedIndex="0" Height="32">
                <ComboBoxItem Content="8"/><ComboBoxItem Content="7"/>
              </ComboBox>
            </StackPanel>
            <StackPanel Margin="0,0,10,0">
              <TextBlock Text="校验位" Foreground="#6B7280"/>
              <ComboBox x:Name="ParityCombo" SelectedIndex="0" Height="32">
                <ComboBoxItem Content="无校验" Tag="None"/><ComboBoxItem Content="偶校验" Tag="Even"/><ComboBoxItem Content="奇校验" Tag="Odd"/>
              </ComboBox>
            </StackPanel>
            <StackPanel>
              <TextBlock Text="停止位" Foreground="#6B7280"/>
              <ComboBox x:Name="StopBitsCombo" SelectedIndex="0" Height="32">
                <ComboBoxItem Content="1 位" Tag="One"/><ComboBoxItem Content="2 位" Tag="Two"/>
              </ComboBox>
            </StackPanel>
          </UniformGrid>
          <UniformGrid Columns="3" Margin="0,12,0,0">
            <StackPanel Margin="0,0,10,0">
              <TextBlock Text="从站地址（1～247）" Foreground="#6B7280"/>
              <TextBox x:Name="AddrBox" Text="1" Height="30"/>
            </StackPanel>
            <StackPanel Margin="0,0,10,0">
              <TextBlock Text="读取超时（毫秒）" Foreground="#6B7280"/>
              <TextBox x:Name="TimeoutBox" Text="3000" Height="30"/>
            </StackPanel>
            <StackPanel>
              <TextBlock Text="采集间隔（秒，1～60）" Foreground="#6B7280"/>
              <TextBox x:Name="IntervalBox" Text="5" Height="30"/>
            </StackPanel>
          </UniformGrid>
          <TextBlock Margin="0,12,0,0" Foreground="#6B7280" TextWrapping="Wrap">
            以上为继承既有实现的默认值（9600 8N1、地址 1）。实物设置必须与这里一致，否则会读取失败。
            使用 USB 转 RS-485 时，请先装好转换器驱动，并确认传感器已独立供电。
          </TextBlock>
        </StackPanel>

        <StackPanel x:Name="Page3" Visibility="Collapsed">
          <TextBlock Text="第 3 步：测试读取" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
          <TextBlock TextWrapping="Wrap">
            打开串口成功并不代表已连上传感器。点击下面的按钮，会分别向传感器请求温度和湿度，
            并分别给出成功或失败的原因。
          </TextBlock>
          <Button Content="开始测试读取" Click="TestRead_Click" Padding="18,9" Margin="0,14,0,0" HorizontalAlignment="Left" Background="#E8F5E9"/>
          <Border Background="White" CornerRadius="8" Padding="14" Margin="0,14,0,0" BorderBrush="#DDE1E6" BorderThickness="1">
            <TextBlock x:Name="TestResult" TextWrapping="Wrap" FontFamily="Consolas, Microsoft YaHei UI"/>
          </Border>
          <TextBlock Margin="0,12,0,0" Foreground="#B26A00" TextWrapping="Wrap">
            若两个指标都失败，也可以先继续下一步完成保存方式设置，稍后在主窗口再测试。
            这样不会把"未连接"当成"连接成功"。
          </TextBlock>
        </StackPanel>

        <StackPanel x:Name="Page4" Visibility="Collapsed">
          <TextBlock Text="第 4 步：选择数据保存方式" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
          <RadioButton x:Name="RbSqlite" Content="本机保存（推荐，免安装数据库）" IsChecked="True" Margin="0,6,0,4"/>
          <TextBlock Text="本机 SQLite 文件路径（必须有写权限的本地目录）" Foreground="#6B7280" Margin="22,4,0,0"/>
          <TextBox x:Name="SqlitePathBox" Margin="22,4,0,0" Height="30"/>
          <RadioButton x:Name="RbSqlServer" Content="同时保存到 SQL Server" Margin="0,14,0,4"/>
          <TextBlock Text="选择此项时，本机 SQLite 仍会持续留存（本地是可靠记录的主体）；远端同步已启用：断网时先存本机，恢复后自动补传，重放不会重复。未同步项会在“存储与数据”页显示。"
                     Foreground="#6B7280" TextWrapping="Wrap" Margin="22,0,0,0"/>
          <TextBlock Text="服务器 / 实例（例如 .\\SQLEXPRESS）" Foreground="#6B7280" Margin="22,8,0,0"/>
          <TextBox x:Name="SqlServerBox" Margin="22,4,0,0" Height="30"/>
          <TextBlock Text="说明：密码不写入本向导、配置文件或日志（凭据由 Windows 凭据保护）。" Foreground="#6B7280"
                     TextWrapping="Wrap" Margin="22,8,0,0"/>
        </StackPanel>

        <StackPanel x:Name="Page5" Visibility="Collapsed">
          <TextBlock Text="第 5 步：命名设备与位置（可选上下限）" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
          <TextBlock Text="设备名称" Foreground="#6B7280"/>
          <TextBox x:Name="DeviceNameBox" Text="温湿度传感器" Height="30"/>
          <TextBlock Text="安装位置（例如：1 号库房）" Foreground="#6B7280" Margin="0,10,0,0"/>
          <TextBox x:Name="LocationBox" Height="30"/>
          <TextBlock Text="超限告警上下限（初始为空 = 未配置阈值，历史不会被追溯标红）" Foreground="#6B7280" Margin="0,14,0,0" TextWrapping="Wrap"/>
          <UniformGrid Columns="4" Margin="0,6,0,0">
            <StackPanel Margin="0,0,10,0">
              <TextBlock Text="温度下限 (℃)" Foreground="#6B7280"/>
              <TextBox x:Name="TempLowBox" Height="30"/>
            </StackPanel>
            <StackPanel Margin="0,0,10,0">
              <TextBlock Text="温度上限 (℃)" Foreground="#6B7280"/>
              <TextBox x:Name="TempHighBox" Height="30"/>
            </StackPanel>
            <StackPanel Margin="0,0,10,0">
              <TextBlock Text="湿度下限 (%RH)" Foreground="#6B7280"/>
              <TextBox x:Name="HumLowBox" Height="30"/>
            </StackPanel>
            <StackPanel>
              <TextBlock Text="湿度上限 (%RH)" Foreground="#6B7280"/>
              <TextBox x:Name="HumHighBox" Height="30"/>
            </StackPanel>
          </UniformGrid>
          <TextBlock Margin="0,12,0,0" Foreground="#6B7280" TextWrapping="Wrap">
            不把医院冷藏阈值当作通用环境阈值：这里留空即表示不启用超限判定。
            下限必须严格小于上限，等于边界算正常。
          </TextBlock>
        </StackPanel>

        <StackPanel x:Name="Page6" Visibility="Collapsed">
          <TextBlock Text="第 6 步：开始记录" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
          <Border Background="White" CornerRadius="8" Padding="14" BorderBrush="#DDE1E6" BorderThickness="1">
            <TextBlock x:Name="SummaryText" TextWrapping="Wrap" FontFamily="Consolas, Microsoft YaHei UI"/>
          </Border>
          <TextBlock Margin="0,12,0,0" TextWrapping="Wrap">
            点击“完成”后会保存配置并开始采集。也可以选择“仅保存配置”，稍后在主窗口手动开始。
          </TextBlock>
          <CheckBox x:Name="StartNowCheck" Content="完成后立即开始记录" IsChecked="True" Margin="0,12,0,0"/>
          <TextBlock x:Name="DoneText" Margin="0,12,0,0" TextWrapping="Wrap" Foreground="#2E7D32"/>
        </StackPanel>
      </Grid>
    </ScrollViewer>
  </DockPanel>
</Window>