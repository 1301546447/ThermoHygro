<Window x:Class="ThermoHygro.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="温湿度监测记录 0.5.0" Height="780" Width="1140"
        WindowStartupLocation="CenterScreen"
        FontFamily="Microsoft YaHei UI" FontSize="13"
        Background="#F5F6F8">
  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="14,7"/>
      <Setter Property="Margin" Value="0,0,8,0"/>
      <Setter Property="Background" Value="#FFFFFF"/>
      <Setter Property="BorderBrush" Value="#C9CDD4"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style TargetType="TextBlock" x:Key="Muted">
      <Setter Property="Foreground" Value="#6B7280"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>
    <Style TargetType="Border" x:Key="Card">
      <Setter Property="Background" Value="White"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="16"/>
      <Setter Property="Margin" Value="0,0,0,12"/>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Padding" Value="6,5"/>
      <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Padding" Value="6,5"/>
      <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Margin" Value="0,4,0,4"/>
    </Style>
  </Window.Resources>

  <DockPanel Background="#F5F6F8">
    <Border DockPanel.Dock="Top" Background="#1E5AA0" Padding="16,10">
      <DockPanel>
        <TextBlock Text="温湿度监测记录 0.5.0" Foreground="White" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
        <TextBlock x:Name="HeaderStatus" DockPanel.Dock="Right" Foreground="#DCE9F7" FontSize="12"
                   VerticalAlignment="Center" HorizontalAlignment="Right"/>
      </DockPanel>
    </Border>
    <TabControl x:Name="MainTabs" Margin="10" Background="Transparent" BorderThickness="0">
      <TabItem Header="实时监测">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="6">
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="当前传感器（切换只改变查看对象，其他传感器继续记录）" Style="{StaticResource Muted}"/>
                <ComboBox x:Name="SensorCombo" DisplayMemberPath="SelectionLabel" SelectedValuePath="Device.DeviceId" SelectionChanged="SensorSelection_Changed" Margin="0,6,0,8"/>
                <DataGrid x:Name="SensorOverviewGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" MaxHeight="220" HeadersVisibility="Column">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="*"/>
                    <DataGridTextColumn Header="串口 / 地址" Binding="{Binding Address}" Width="150"/>
                    <DataGridTextColumn Header="温度" Binding="{Binding Temperature}" Width="95"/>
                    <DataGridTextColumn Header="湿度" Binding="{Binding Humidity}" Width="95"/>
                    <DataGridTextColumn Header="状态 / 保存" Binding="{Binding Status}" Width="2*"/>
                  </DataGrid.Columns>
                </DataGrid>
              </StackPanel>
            </Border>
            <UniformGrid Columns="2">
              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock Text="温度" Style="{StaticResource Muted}"/>
                  <TextBlock x:Name="TempCardValue" Text="-- ℃" FontSize="44" FontWeight="SemiBold" Foreground="#E53935"/>
                  <TextBlock x:Name="TempCardState" Text="未读取" Style="{StaticResource Muted}"/>
                  <TextBlock x:Name="TempCardReason" Style="{StaticResource Muted}" TextWrapping="Wrap"/>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock Text="湿度" Style="{StaticResource Muted}"/>
                  <TextBlock x:Name="HumCardValue" Text="-- %RH" FontSize="44" FontWeight="SemiBold" Foreground="#1E88E5"/>
                  <TextBlock x:Name="HumCardState" Text="未读取" Style="{StaticResource Muted}"/>
                  <TextBlock x:Name="HumCardReason" Style="{StaticResource Muted}" TextWrapping="Wrap"/>
                </StackPanel>
              </Border>
            </UniformGrid>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="设备与位置" Style="{StaticResource Muted}"/>
                <TextBlock x:Name="DeviceLine" Text="未配置" FontSize="14"/>
                <TextBlock x:Name="ComLine" Style="{StaticResource Muted}"/>
                <TextBlock x:Name="LastGoodLine" Style="{StaticResource Muted}"/>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="三个独立状态（失败或过期不会显示为正常）" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0">
                    <TextBlock Text="传感器通信" Style="{StaticResource Muted}"/>
                    <TextBlock x:Name="StateComm" Text="未连接" FontSize="16" FontWeight="SemiBold"/>
                  </StackPanel>
                  <StackPanel Grid.Column="1">
                    <TextBlock Text="本地保存" Style="{StaticResource Muted}"/>
                    <TextBlock x:Name="StateLocal" Text="未知" FontSize="16" FontWeight="SemiBold"/>
                  </StackPanel>
                  <StackPanel Grid.Column="2">
                    <TextBlock Text="远端同步" Style="{StaticResource Muted}"/>
                    <TextBlock x:Name="StateRemote" Text="未启用" FontSize="16" FontWeight="SemiBold"/>
                  </StackPanel>
                </Grid>
                <TextBlock x:Name="StateDetail" Style="{StaticResource Muted}" Margin="0,8,0,0" TextWrapping="Wrap"/>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <DockPanel>
                  <TextBlock Text="近 1 小时趋势" FontWeight="SemiBold"/>
                  <Button Content="刷新" DockPanel.Dock="Right" HorizontalAlignment="Right" Click="RefreshTrend_Click"/>
                </DockPanel>
                <Canvas x:Name="TrendCanvas" Height="170" Margin="0,8,0,0" Background="#FAFBFC" ClipToBounds="True"/>
                <TextBlock x:Name="TrendLegend" Style="{StaticResource Muted}" Margin="0,6,0,0"/>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
              <StackPanel Orientation="Horizontal">
                <Button x:Name="BtnStart" Content="开始记录" Click="StartAcquisition_Click" Background="#E8F5E9"/>
                <Button x:Name="BtnPause" Content="暂停采集" Click="PauseAcquisition_Click"/>
                <Button x:Name="BtnTest" Content="测试读取" Click="TestRead_Click"/>
                <TextBlock x:Name="ActionFeedback" VerticalAlignment="Center" Style="{StaticResource Muted}"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="历史报表">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="6">
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="历史报表（日/月/自定义区间；粒度自动切换：1 天=分钟，2～31 天=小时，更长=每日）" Style="{StaticResource Muted}" TextWrapping="Wrap"/>
                <ComboBox x:Name="HistorySensorCombo" DisplayMemberPath="DisplayName" SelectedValuePath="DeviceId" Margin="0,8,0,0" SelectionChanged="HistorySensor_Changed"/>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                  <TextBlock Text="自定义日期：" VerticalAlignment="Center"/>
                  <DatePicker x:Name="HistoryStartDate" Width="150"/>
                  <TextBlock Text=" 至 " VerticalAlignment="Center"/>
                  <DatePicker x:Name="HistoryEndDate" Width="150"/>
                  <TextBlock Text="（包含结束日）" VerticalAlignment="Center" Style="{StaticResource Muted}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                  <ComboBox x:Name="HistoryScopeCombo" SelectedIndex="0" Width="140">
                    <ComboBoxItem Content="近 30 天"/>
                    <ComboBoxItem Content="近 7 天"/>
                    <ComboBoxItem Content="今天"/>
                    <ComboBoxItem Content="本月"/>
                    <ComboBoxItem Content="自定义日期"/>
                  </ComboBox>
                  <Button Content="查询" Click="QueryHistory_Click"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                  <Button Content="导出 CSV（汇总+事件）" Click="ExportCsv_Click"/>
                  <Button Content="导出 PDF 报告" Click="ExportPdf_Click"/>
                  <Button Content="备份本地库" Click="Backup_Click"/>
                  <Button Content="验证备份" Click="VerifyBackup_Click"/>
                </StackPanel>
                <TextBlock x:Name="HistorySummary" Margin="0,10,0,0" TextWrapping="Wrap"/>
                <TextBlock x:Name="ReportFontStatus" Margin="0,4,0,0" Style="{StaticResource Muted}" TextWrapping="Wrap"/>
                <DataGrid x:Name="HistoryGrid" Height="380" Margin="0,10,0,0" AutoGenerateColumns="True"
                          IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal" Background="White"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="设备与串口">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="6">
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="传感器维护" FontWeight="SemiBold"/>
                <ComboBox x:Name="DeviceSensorCombo" DisplayMemberPath="SelectionLabel" SelectedValuePath="Device.DeviceId" SelectionChanged="SensorSelection_Changed" Margin="0,8,0,8"/>
                <StackPanel Orientation="Horizontal">
                  <Button Content="增加传感器" Click="AddSensor_Click"/>
                  <Button Content="移除当前传感器" Click="RemoveSensor_Click"/>
                  <CheckBox x:Name="SensorEnabledCheck" Content="启用当前传感器" VerticalAlignment="Center" Margin="8,0,0,0"/>
                </StackPanel>
                <TextBlock Text="增加后填写名称、串口和实物地址，再点击保存设备信息。同一串口使用不同地址；不同串口可使用相同地址。移除后历史记录仍可查询。" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0"/>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="串口设置（运行中修改：验证 → 暂停旧采集 → 释放旧串口 → 应用 → 失败可一键恢复）" FontWeight="SemiBold"/>
                <TextBlock Text="端口名称（可手填，如 COM12）" Style="{StaticResource Muted}" Margin="0,8,0,2"/>
                <DockPanel>
                  <Button DockPanel.Dock="Right" Content="刷新串口列表" Click="RefreshPorts_Click"/>
                  <ComboBox x:Name="PortCombo" IsEditable="True" Margin="0,0,8,6"/>
                </DockPanel>
                <TextBlock x:Name="PortHint" Style="{StaticResource Muted}" TextWrapping="Wrap"/>
                <UniformGrid Columns="4" Margin="0,8,0,0">
                  <StackPanel Margin="0,0,8,0">
                    <TextBlock Text="波特率" Style="{StaticResource Muted}"/>
                    <ComboBox x:Name="BaudCombo">
                      <ComboBoxItem Content="1200"/><ComboBoxItem Content="2400"/>
                      <ComboBoxItem Content="4800"/><ComboBoxItem Content="9600"/>
                      <ComboBoxItem Content="19200"/><ComboBoxItem Content="38400"/>
                      <ComboBoxItem Content="57600"/><ComboBoxItem Content="115200"/>
                    </ComboBox>
                  </StackPanel>
                  <StackPanel Margin="0,0,8,0">
                    <TextBlock Text="数据位" Style="{StaticResource Muted}"/>
                    <ComboBox x:Name="DataBitsCombo">
                      <ComboBoxItem Content="8"/><ComboBoxItem Content="7"/>
                    </ComboBox>
                  </StackPanel>
                  <StackPanel Margin="0,0,8,0">
                    <TextBlock Text="校验位" Style="{StaticResource Muted}"/>
                    <ComboBox x:Name="ParityCombo">
                      <ComboBoxItem Content="无校验" Tag="None"/><ComboBoxItem Content="偶校验" Tag="Even"/><ComboBoxItem Content="奇校验" Tag="Odd"/>
                    </ComboBox>
                  </StackPanel>
                  <StackPanel>
                    <TextBlock Text="停止位" Style="{StaticResource Muted}"/>
                    <ComboBox x:Name="StopBitsCombo">
                      <ComboBoxItem Content="1 位" Tag="One"/><ComboBoxItem Content="2 位" Tag="Two"/>
                    </ComboBox>
                  </StackPanel>
                </UniformGrid>
                <UniformGrid Columns="3" Margin="0,8,0,0">
                  <StackPanel Margin="0,0,8,0">
                    <TextBlock Text="从站地址（1～247）" Style="{StaticResource Muted}"/>
                    <TextBox x:Name="SlaveAddrBox" Text="1"/>
                  </StackPanel>
                  <StackPanel Margin="0,0,8,0">
                    <TextBlock Text="读取超时（毫秒，≥200）" Style="{StaticResource Muted}"/>
                    <TextBox x:Name="TimeoutBox" Text="3000"/>
                  </StackPanel>
                  <StackPanel>
                    <TextBlock Text="采集间隔（秒，1～60）" Style="{StaticResource Muted}"/>
                    <TextBox x:Name="IntervalBox" Text="5"/>
                  </StackPanel>
                </UniformGrid>
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                  <Button Content="保存设置" Click="SaveSerial_Click" Background="#E8F5E9"/>
                  <Button Content="测试读取" Click="TestRead_Click"/>
                  <Button Content="取消修改" Click="CancelSerial_Click"/>
                  <Button x:Name="BtnRestoreSerial" Content="恢复上次可用配置" Click="RestoreSerial_Click"/>
                </StackPanel>
                <TextBlock x:Name="SerialFeedback" Margin="0,10,0,0" TextWrapping="Wrap"/>
                <TextBlock x:Name="TestResultText" Margin="0,8,0,0" TextWrapping="Wrap" Style="{StaticResource Muted}"/>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="设备身份与型号" FontWeight="SemiBold"/>
                <TextBlock Text="设备名称" Style="{StaticResource Muted}" Margin="0,8,0,2"/>
                <TextBox x:Name="DeviceNameBox"/>
                <TextBlock Text="安装位置" Style="{StaticResource Muted}" Margin="0,4,0,2"/>
                <TextBox x:Name="LocationBox"/>
                <TextBlock x:Name="ModelText" Margin="0,8,0,0" TextWrapping="Wrap"/>
                <TextBlock x:Name="DeviceIdText" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                  <Button Content="保存设备信息" Click="SaveDevice_Click"/>
                  <Button Content="更换实物，建立新编号" Click="NewDevice_Click"/>
                </StackPanel>
                <TextBlock x:Name="DeviceFeedback" Margin="0,8,0,0" TextWrapping="Wrap"/>
                <TextBlock Text="当前传感器上下限（留空关闭该项；仅影响新记录）" FontWeight="SemiBold" Margin="0,14,0,8"/>
                <UniformGrid Columns="4">
                  <StackPanel Margin="0,0,8,0"><TextBlock Text="温度下限（℃）"/><TextBox x:Name="SensorTempLow"/></StackPanel>
                  <StackPanel Margin="0,0,8,0"><TextBlock Text="温度上限（℃）"/><TextBox x:Name="SensorTempHigh"/></StackPanel>
                  <StackPanel Margin="0,0,8,0"><TextBlock Text="湿度下限（%RH）"/><TextBox x:Name="SensorHumLow"/></StackPanel>
                  <StackPanel><TextBlock Text="湿度上限（%RH）"/><TextBox x:Name="SensorHumHigh"/></StackPanel>
                </UniformGrid>
                <Button Content="保存当前传感器上下限" Click="SaveSensorThresholds_Click" HorizontalAlignment="Left"/>
                <TextBlock x:Name="SensorThresholdFeedback" TextWrapping="Wrap" Margin="0,8,0,0"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="数据存储">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="6">
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="保存方式" FontWeight="SemiBold"/>
                <RadioButton x:Name="ModeSqlite" Content="本机保存（推荐，无需安装数据库）" Checked="StorageMode_Changed" Margin="0,8,0,2"/>
                <RadioButton x:Name="ModeSqlServer" Content="同时保存到 SQL Server（本机仍持续留存）" Checked="StorageMode_Changed" Margin="0,0,0,8"/>
                <TextBlock Text="本地数据库文件" Style="{StaticResource Muted}"/>
                <TextBox x:Name="SqlitePathBox"/>
                <TextBlock Text="SQL Server 连接（服务器/实例；密码不写入配置与日志）" Style="{StaticResource Muted}"/>
                <TextBox x:Name="SqlServerBox"/>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                  <Button Content="应用并初始化存储" Click="ApplyStorage_Click" Background="#E8F5E9"/>
                  <Button Content="打开数据目录" Click="OpenDataFolder_Click"/>
                </StackPanel>
                <TextBlock x:Name="StorageFeedback" Margin="0,10,0,0" TextWrapping="Wrap"/>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="存储状态" FontWeight="SemiBold"/>
                <TextBlock x:Name="StorageStats" Margin="0,8,0,0" TextWrapping="Wrap"/>
                <TextBlock x:Name="RemoteStats" Margin="0,6,0,0" TextWrapping="Wrap"/>
                <Button Content="刷新统计" Click="RefreshStorage_Click" Margin="0,10,0,0" HorizontalAlignment="Left"/>
                <TextBlock Text="说明：逐次样本默认保留 7 天（自动清理，分钟汇总长期保留）。"
                           Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0"/>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="监控事件（超限/恢复/缺测/重连/存储故障/时钟跳变等，只记状态变化不重复刷屏）" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <Button Content="刷新事件" Click="RefreshEvents_Click" Margin="0,8,0,0" HorizontalAlignment="Left"/>
                <TextBlock x:Name="EventSummary" Margin="0,8,0,0" TextWrapping="Wrap"/>
                <DataGrid x:Name="EventGrid" Height="200" Margin="0,8,0,0" AutoGenerateColumns="True"
                          IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal" Background="White"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="悬浮显示">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="6">
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="悬浮读数显示（修改即时预览；取消则还原）" FontWeight="SemiBold"/>
                <CheckBox x:Name="OverlayEnabled" Content="启用悬浮显示" Checked="Overlay_Changed" Unchecked="Overlay_Changed"/>
                <CheckBox x:Name="OverlayShowTemp" Content="显示温度" Checked="Overlay_Changed" Unchecked="Overlay_Changed"/>
                <CheckBox x:Name="OverlayShowHum" Content="显示湿度" Checked="Overlay_Changed" Unchecked="Overlay_Changed"/>
                <CheckBox x:Name="OverlayShowDevice" Content="显示设备简称" Checked="Overlay_Changed" Unchecked="Overlay_Changed"/>
                <CheckBox x:Name="OverlayShowStatus" Content="显示状态小字" Checked="Overlay_Changed" Unchecked="Overlay_Changed"/>
                <CheckBox x:Name="OverlayShadow" Content="文字阴影（保证浅色背景下可读）" Checked="Overlay_Changed" Unchecked="Overlay_Changed"/>
                <CheckBox x:Name="OverlayClickThrough" Content="鼠标穿透（不阻挡桌面操作）" Checked="Overlay_Changed" Unchecked="Overlay_Changed"/>
                <Grid Margin="0,10,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <TextBlock Text="位置（四角）" Style="{StaticResource Muted}"/>
                    <ComboBox x:Name="CornerCombo" SelectionChanged="Overlay_SelectionChanged">
                      <ComboBoxItem Content="左上" Tag="TopLeft"/>
                      <ComboBoxItem Content="右上" Tag="TopRight"/>
                      <ComboBoxItem Content="左下" Tag="BottomLeft"/>
                      <ComboBoxItem Content="右下" Tag="BottomRight"/>
                      <ComboBoxItem Content="居中" Tag="Center"/>
                    </ComboBox>
                  </StackPanel>
                  <StackPanel Grid.Column="1">
                    <TextBlock Text="显示器" Style="{StaticResource Muted}"/>
                    <ComboBox x:Name="DisplayCombo" SelectionChanged="Overlay_SelectionChanged"/>
                  </StackPanel>
                </Grid>
                <UniformGrid Columns="2" Margin="0,8,0,0">
                  <StackPanel Margin="0,0,10,0">
                    <TextBlock Text="水平边距" Style="{StaticResource Muted}"/>
                    <TextBox x:Name="MarginXBox" Text="24"/>
                  </StackPanel>
                  <StackPanel>
                    <TextBlock Text="垂直边距" Style="{StaticResource Muted}"/>
                    <TextBox x:Name="MarginYBox" Text="24"/>
                  </StackPanel>
                </UniformGrid>
                <TextBlock x:Name="FontSizeLabel" Style="{StaticResource Muted}" Margin="0,8,0,0"/>
                <Slider x:Name="FontSizeSlider" Minimum="16" Maximum="96" Value="32" TickFrequency="4"
                        IsSnapToTickEnabled="True" ValueChanged="FontSize_Changed"/>
                <UniformGrid Columns="4" Margin="0,8,0,0">
                  <StackPanel Margin="0,0,8,0">
                    <TextBlock Text="温度颜色" Style="{StaticResource Muted}"/>
                    <TextBox x:Name="TempColorBox" Text="#E53935" TextChanged="Overlay_TextChanged"/>
                  </StackPanel>
                  <StackPanel Margin="0,0,8,0">
                    <TextBlock Text="湿度颜色" Style="{StaticResource Muted}"/>
                    <TextBox x:Name="HumColorBox" Text="#1E88E5" TextChanged="Overlay_TextChanged"/>
                  </StackPanel>
                  <StackPanel Margin="0,0,8,0">
                    <TextBlock Text="文字颜色" Style="{StaticResource Muted}"/>
                    <TextBox x:Name="TextColorBox" Text="#FFFFFF" TextChanged="Overlay_TextChanged"/>
                  </StackPanel>
                  <StackPanel>
                    <TextBlock Text="背景不透明度（0=全透明）" Style="{StaticResource Muted}"/>
                    <TextBox x:Name="BgOpacityBox" Text="0" TextChanged="Overlay_TextChanged"/>
                  </StackPanel>
                </UniformGrid>
                <TextBlock x:Name="TextOpacityLabel" Style="{StaticResource Muted}" Margin="0,8,0,0"/>
                <Slider x:Name="TextOpacitySlider" Minimum="0.15" Maximum="1" Value="1" TickFrequency="0.05"
                        ValueChanged="Overlay_SliderChanged"/>
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                  <Button Content="保存悬浮设置" Click="SaveOverlay_Click" Background="#E8F5E9"/>
                  <Button Content="取消（还原）" Click="CancelOverlay_Click"/>
                  <Button Content="恢复默认" Click="ResetOverlay_Click"/>
                  <Button Content="重新定位到可见区" Click="RepositionOverlay_Click"/>
                </StackPanel>
                <TextBlock x:Name="OverlayFeedback" Margin="0,10,0,0" TextWrapping="Wrap"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="日志与帮助">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="6">
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="常驻与退出" FontWeight="SemiBold"/>
                <CheckBox x:Name="AutoStartAcq" Content="启动时自动开始采集（默认关闭）" Checked="Startup_Changed" Unchecked="Startup_Changed"/>
                <CheckBox x:Name="StartWithWindows" Content="登录 Windows 后自动启动（默认关闭）" Checked="Startup_Changed" Unchecked="Startup_Changed"/>
                <TextBlock Text="说明：关闭主窗口（X）会继续采集并进入托盘；选择“退出”才停止采集、提交样本并释放串口。"
                           Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                  <Button Content="最小化到托盘（继续采集）" Click="MinimizeToTray_Click"/>
                  <Button Content="退出程序" Click="ExitApp_Click" Background="#FFEBEE"/>
                </StackPanel>
                <TextBlock Text="退出会先停止采集、让本轮已接收的样本完成保存，再释放串口；已保存的数据不会丢失。"
                           Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0"/>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="运行日志（最近 300 行）" FontWeight="SemiBold"/>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                  <Button Content="刷新日志" Click="RefreshLog_Click"/>
                  <Button Content="打开日志目录" Click="OpenLogFolder_Click"/>
                  <Button Content="打开数据目录" Click="OpenDataFolder_Click"/>
                </StackPanel>
                <TextBox x:Name="LogText" Height="320" Margin="0,10,0,0" IsReadOnly="True"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         FontFamily="Consolas, Microsoft YaHei UI" FontSize="12" AcceptsReturn="True"
                         TextWrapping="NoWrap"/>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="帮助" FontWeight="SemiBold"/>
                <TextBlock TextWrapping="Wrap" Margin="0,8,0,0">
                  1. 接线与驱动：传感器需 USB 转 RS-485 转换器与独立供电，先安装转换器驱动，再在“设备与串口”刷新串口。
                  2. 串口参数必须与实物一致（默认 9600 8N1、地址 1）。打开串口成功不代表已连上传感器，请用“测试读取”确认。
                  3. 数据保存：默认本机 SQLite（免安装）；选择 SQL Server 时本机仍持续留存。
                  4. 悬浮显示：默认透明背景、置顶、鼠标穿透；可在托盘关闭穿透或恢复位置。
                  5. 退出：托盘菜单“退出”会停止采集并释放串口；X 关闭窗口不会停止采集。
                </TextBlock>
                <TextBlock x:Name="HelpText2" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,10,0,0"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
